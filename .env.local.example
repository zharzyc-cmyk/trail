# Supabase（前往 https://supabase.com/dashboard 项目 Settings → API 抓）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic API Key（前往 https://console.anthropic.com/settings/keys 创建）
ANTHROPIC_API_KEY=sk-ant-api03-...

# 可选：Anthropic API 中转地址（用 Anthropic 官方时留空，国内中转站填中转 baseURL）
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# 可选：DeepSeek API Key（仅当 TAILOR_MODEL 以 deepseek- 开头时用到，走 DeepSeek 的
# Anthropic 兼容端点 https://api.deepseek.com/anthropic）
# DEEPSEEK_API_KEY=sk-...

# 可选：tailor 阶段 2 用的 model ID。不设置默认 Anthropic Haiku；填 deepseek-v4-pro
# / deepseek-chat 等会自动切到 DeepSeek 兼容端点。selector 阶段固定 Anthropic Haiku
# TAILOR_MODEL=claude-haiku-4-5-20251001

# 限额
DAILY_LIMIT_PER_USER=10

# 配额无限制邮箱白名单（逗号分隔），适用于自己/演示账号
# UNLIMITED_USER_EMAILS=you@example.com
